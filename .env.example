# Telegram bot
BOT_TOKEN=your_token_here
# Через запятую — ID админов (узнать свой ID: напиши боту @userinfobot)
ADMIN_IDS=123456789
# Главный чат/канал (id с минусом, например -1001234567890). Опционально.
MAIN_CHAT_ID=

# База данных (по умолчанию SQLite в ./data/bot.db)
DB_URL=sqlite+aiosqlite:///data/bot.db

# Captcha
CAPTCHA_TIMEOUT_SEC=60

# Антиспам
RATE_LIMIT_MSGS=5
RATE_LIMIT_WINDOW_SEC=10
NEW_USER_HOURS=24
MAX_WARNINGS=3

# Логирование
LOG_LEVEL=INFO
