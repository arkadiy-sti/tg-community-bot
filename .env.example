# --- Telegram ---
# Токен бота от @BotFather. Для prod-инстанса = prod токен, для dev = dev токен.
BOT_TOKEN=your_token_here

# Профиль запуска: prod (реальные пользователи) или dev (тестовый бот).
BOT_PROFILE=prod

# ID админов через запятую. Узнать свой: напиши боту @userinfobot.
ADMIN_IDS=125293998

# ID группы/канала для публикации объявлений (с минусом, формата -100...).
# В Co-Workers Bay Area = -1002186030111.
CHANNEL_ID=-1002186030111

# (опционально) ID главного чата, если нужен (для антиспама/капчи в группе).
# Часто совпадает с CHANNEL_ID.
MAIN_CHAT_ID=-1002186030111

# --- Локализация ---
# По умолчанию для новых пользователей. ru | en
DEFAULT_LANG=ru

# --- База данных ---
# Прод: PostgreSQL. Формат для асинхронного драйвера:
#   postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME
# Создание баз (один раз, на VPS):
#   sudo -u postgres psql -c "CREATE USER tgbot WITH PASSWORD '...';"
#   sudo -u postgres psql -c "CREATE DATABASE tgbot_prod OWNER tgbot;"
#   sudo -u postgres psql -c "CREATE DATABASE tgbot_dev  OWNER tgbot;"
DB_URL=postgresql+asyncpg://tgbot:CHANGE_ME@localhost/tgbot_prod
# Для локальной разработки можно SQLite:
#   DB_URL=sqlite+aiosqlite:///data/bot.db

# --- Captcha / антиспам ---
CAPTCHA_TIMEOUT_SEC=60
RATE_LIMIT_MSGS=5
RATE_LIMIT_WINDOW_SEC=10
NEW_USER_HOURS=24
MAX_WARNINGS=3

# --- Логирование ---
LOG_LEVEL=INFO
